# The page the browser gets at "/". It is a string rather than a file so the
# program stays one self-contained thing: `mah run` and nothing else is enough.
#
# The JavaScript in it talks to the same JSON API any other client would use --
# nothing here is special-cased server side, so what you see in the browser is
# what curl does.
export fn page() -> String {
    [
        "<!doctype html>",
        "<html lang='en'>",
        "<head>",
        "<meta charset='utf-8'>",
        "<meta name='viewport' content='width=device-width, initial-scale=1'>",
        "<title>p05 todos</title>",
        "<style>",
        ":root { color-scheme: light dark; }",
        "body { font: 16px/1.5 system-ui, sans-serif; margin: 0; padding: 2.5rem 1rem; }",
        "main { max-width: 32rem; margin: 0 auto; }",
        "h1 { font-size: 1.3rem; margin: 0 0 .2rem; }",
        "p.hint { margin: 0 0 1.4rem; opacity: .6; font-size: .85rem; }",
        "form { display: flex; gap: .5rem; }",
        "input[type=text] { flex: 1; padding: .5rem .6rem; border: 1px solid #8886;",
        "  border-radius: .4rem; background: #fff1; color: inherit; font: inherit; }",
        "button { padding: .5rem .8rem; border: 1px solid #8886; border-radius: .4rem;",
        "  background: #8881; color: inherit; font: inherit; cursor: pointer; }",
        "button:hover { background: #8883; }",
        ".bar { display: flex; gap: .5rem; align-items: center; margin-top: 1.2rem; }",
        ".bar .count { margin-left: auto; font-size: .85rem; opacity: .65; }",
        "ul { list-style: none; padding: 0; margin: 1rem 0 0; }",
        "li { display: flex; gap: .65rem; align-items: center; padding: .55rem .2rem;",
        "  border-top: 1px solid #8883; }",
        "li .title { flex: 1; }",
        "li.done .title { text-decoration: line-through; opacity: .55; }",
        "li .delete { padding: .2rem .5rem; line-height: 1.2; }",
        "#status { min-height: 1.3em; margin-top: 1rem; font-size: .85rem; }",
        "#status.bad { color: #c0392b; }",
        "</style>",
        "</head>",
        "<body>",
        "<main>",
        "<h1>todos</h1>",
        "<p class='hint'>stored in a variable while the program runs</p>",
        "<form id='new'>",
        "  <input id='title' type='text' placeholder='what needs doing?' autocomplete='off'>",
        "  <button type='submit'>add</button>",
        "</form>",
        "<div class='bar'>",
        "  <button data-done=''>all</button>",
        "  <button data-done='false'>open</button>",
        "  <button data-done='true'>done</button>",
        "  <button id='reload'>reload</button>",
        "  <span class='count' id='count'></span>",
        "</div>",
        "<ul id='list'></ul>",
        "<div id='status'></div>",
        "</main>",
        "<script>",
        "const list = document.getElementById('list')",
        "const count = document.getElementById('count')",
        "const status = document.getElementById('status')",
        "const title = document.getElementById('title')",
        "let done = ''",
        "",
        "// Every call is a plain fetch against the JSON API, errors included.",
        "async function call(method, path, body) {",
        "  const res = await fetch(path, {",
        "    method: method,",
        "    headers: body === undefined ? {} : { 'content-type': 'application/json' },",
        "    body: body === undefined ? undefined : JSON.stringify(body)",
        "  })",
        "  const text = await res.text()",
        "  let data = null",
        "  try { data = text === '' ? null : JSON.parse(text) } catch (e) { data = null }",
        "  if (!res.ok) { throw new Error(data && data.message ? data.message : res.status + ' ' + res.statusText) }",
        "  return data",
        "}",
        "",
        "function say(text, bad) {",
        "  status.textContent = text",
        "  status.className = bad ? 'bad' : ''",
        "}",
        "",
        "function row(todo) {",
        "  const item = document.createElement('li')",
        "  if (todo.done) item.className = 'done'",
        "  const box = document.createElement('input')",
        "  box.type = 'checkbox'",
        "  box.checked = todo.done",
        "  box.onchange = () => work(() => call('PATCH', '/todos/' + todo.id, { done: box.checked }))",
        "  const label = document.createElement('span')",
        "  label.className = 'title'",
        "  label.textContent = todo.title",
        "  const drop = document.createElement('button')",
        "  drop.className = 'delete'",
        "  drop.textContent = 'remove'",
        "  drop.onclick = () => work(() => call('DELETE', '/todos/' + todo.id))",
        "  item.append(box, label, drop)",
        "  return item",
        "}",
        "",
        "function draw(todos) {",
        "  list.textContent = ''",
        "  for (const todo of todos) { list.appendChild(row(todo)) }",
        "  if (todos.length === 0) {",
        "    const empty = document.createElement('li')",
        "    empty.textContent = 'nothing here yet'",
        "    list.appendChild(empty)",
        "  }",
        "  count.textContent = todos.length + (todos.length === 1 ? ' todo' : ' todos')",
        "}",
        "",
        "// Do the thing, then show the truth: reload first, then say what went",
        "// wrong if anything did.",
        "async function work(action) {",
        "  let bad = null",
        "  try { await action() } catch (e) { bad = e }",
        "  await load()",
        "  if (bad !== null) { say(bad.message, true) }",
        "}",
        "",
        "async function load() {",
        "  try {",
        "    const query = done === '' ? '' : '?done=' + done",
        "    const data = await call('GET', '/todos' + query)",
        "    draw(data.todos)",
        "    say('')",
        "  } catch (e) {",
        "    say(e.message, true)",
        "  }",
        "}",
        "",
        "document.getElementById('new').onsubmit = (event) => {",
        "  event.preventDefault()",
        "  const what = title.value.trim()",
        "  if (what === '') { return }",
        "  title.value = ''",
        "  work(() => call('POST', '/todos', { title: what }))",
        "}",
        "",
        "document.getElementById('reload').onclick = load",
        "for (const button of document.querySelectorAll('[data-done]')) {",
        "  button.onclick = () => { done = button.dataset.done; load() }",
        "}",
        "",
        "title.focus()",
        "load()",
        "</script>",
        "</body>",
        "</html>"
    ].join("\n")
}
