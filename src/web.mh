# The pages the browser gets: the todo list at "/" and Swagger UI at "/docs".
# They are strings rather than files so the program stays one self-contained
# thing: `mah run` and nothing else is enough.
#
# The JavaScript in the todo page talks to the same JSON API any other client
# would use -- nothing here is special-cased server side, so what you see in
# the browser is what curl does. It carries no outside script or style (its
# only outside links are to Mah and this repository); only /docs loads
# Swagger UI from a CDN.

## The Mah language, which this program is written in.
let mahlang = "https://github.com/sina-salahshour/mahlang"

## This program's own source.
let repo = "https://github.com/sina-salahshour/mah-todo-demo"

## The Swagger UI release /docs loads.
let swagger_ui = "https://cdn.jsdelivr.net/npm/swagger-ui-dist@5.17.14"

## The todo list.
export fn page() -> String {
    [
        "<!doctype html>",
        "<html lang='en'>",
        "<head>",
        "<meta charset='utf-8'>",
        "<meta name='viewport' content='width=device-width, initial-scale=1'>",
        "<title>p05 todos</title>",
        "<style>",
        ":root {",
        "  color-scheme: light dark;",
        "  --bg: #f4f5f8; --card: #ffffff; --text: #1d2130; --muted: #6b7183;",
        "  --line: #e3e5ec; --accent: #5b5bd6; --accent-soft: #ececfb; --bad: #d1435b;",
        "  --shadow: 0 1px 2px #0000000d, 0 8px 24px #0000000f;",
        "}",
        "@media (prefers-color-scheme: dark) {",
        "  :root { --bg: #111318; --card: #1a1d24; --text: #e7e9ef; --muted: #8d93a5;",
        "    --line: #2a2e38; --accent: #8b8bf5; --accent-soft: #26264a; --bad: #f07186;",
        "    --shadow: 0 1px 2px #0006, 0 8px 24px #0004; }",
        "}",
        "* { box-sizing: border-box; }",
        "body { margin: 0; min-height: 100vh; background: var(--bg); color: var(--text);",
        "  font: 15px/1.5 system-ui, -apple-system, 'Segoe UI', sans-serif; }",
        "main { max-width: 36rem; margin: 0 auto; padding: 3rem 1rem 2rem; }",
        "header { display: flex; align-items: flex-end; gap: 1rem; margin-bottom: 1.25rem; }",
        "header h1 { margin: 0; font-size: 1.9rem; letter-spacing: -.02em; }",
        "header p { margin: .1rem 0 0; color: var(--muted); font-size: .85rem; }",
        "header nav { margin-left: auto; display: flex; gap: .4rem; }",
        "a.chip { color: var(--accent); background: var(--accent-soft); text-decoration: none;",
        "  padding: .3rem .7rem; border-radius: 999px; font-size: .8rem; font-weight: 600;",
        "  white-space: nowrap; }",
        "a.chip:hover { filter: brightness(1.08); }",
        ".card { background: var(--card); border-radius: .9rem; box-shadow: var(--shadow);",
        "  overflow: hidden; }",
        "form { display: flex; gap: .5rem; padding: .8rem; border-bottom: 1px solid var(--line); }",
        "input[type=text] { flex: 1; min-width: 0; padding: .6rem .75rem; border: 1px solid var(--line);",
        "  border-radius: .55rem; background: transparent; color: inherit; font: inherit; }",
        "input[type=text]:focus { outline: 2px solid var(--accent); outline-offset: -1px; border-color: transparent; }",
        "button { font: inherit; color: inherit; cursor: pointer; border: 0; background: none; }",
        "button.primary { background: var(--accent); color: #fff; font-weight: 600;",
        "  padding: .6rem 1rem; border-radius: .55rem; }",
        "button.primary:hover { filter: brightness(1.08); }",
        ".progress { height: 3px; background: var(--line); }",
        ".progress div { height: 100%; width: 0; background: var(--accent); transition: width .3s; }",
        ".bar { display: flex; align-items: center; gap: .3rem; padding: .55rem .8rem;",
        "  border-bottom: 1px solid var(--line); font-size: .85rem; }",
        ".bar .count { color: var(--muted); margin-right: auto; }",
        ".filters button { padding: .25rem .65rem; border-radius: 999px; color: var(--muted); }",
        ".filters button:hover { color: var(--text); }",
        ".filters button[aria-pressed=true] { background: var(--accent-soft); color: var(--accent); font-weight: 600; }",
        "ul { list-style: none; padding: 0; margin: 0; }",
        "li { display: flex; gap: .75rem; align-items: center; padding: .7rem .9rem;",
        "  border-bottom: 1px solid var(--line); }",
        "li:last-child { border-bottom: 0; }",
        "li .check { appearance: none; flex: none; width: 1.25rem; height: 1.25rem; margin: 0;",
        "  border: 2px solid var(--line); border-radius: 50%; cursor: pointer; display: grid; place-content: center; }",
        "li .check:checked { background: var(--accent); border-color: var(--accent); }",
        "li .check:checked::after { content: ''; width: .3rem; height: .55rem; margin-top: -.12rem;",
        "  border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg); }",
        "li .title { flex: 1; min-width: 0; overflow-wrap: anywhere; cursor: text; }",
        "li.done .title { text-decoration: line-through; color: var(--muted); }",
        "li .when { color: var(--muted); font-size: .75rem; white-space: nowrap; }",
        "li .drop { color: var(--muted); font-size: 1.2rem; line-height: 1; padding: .1rem .35rem;",
        "  border-radius: .35rem; opacity: 0; transition: opacity .15s; }",
        "li:hover .drop, li .drop:focus { opacity: 1; }",
        "li .drop:hover { color: var(--bad); background: var(--accent-soft); }",
        "li input.edit { flex: 1; padding: .2rem .4rem; }",
        "li.empty { justify-content: center; color: var(--muted); padding: 2.2rem 1rem; }",
        ".foot { display: flex; align-items: center; padding: .55rem .9rem; font-size: .8rem;",
        "  color: var(--muted); border-top: 1px solid var(--line); }",
        ".foot button { margin-left: auto; color: var(--muted); }",
        ".foot button:hover:not(:disabled) { color: var(--bad); }",
        ".foot button:disabled { opacity: .4; cursor: default; }",
        "#status { min-height: 1.4em; margin: .8rem .2rem 0; font-size: .85rem; color: var(--bad); }",
        "footer { margin-top: 1.5rem; text-align: center; color: var(--muted); font-size: .8rem; }",
        "footer p { margin: .3rem 0; }",
        "footer a { color: inherit; }",
        "footer .made a { color: var(--accent); font-weight: 600; text-decoration: none; }",
        "kbd { font: inherit; border: 1px solid var(--line); border-radius: .3rem; padding: 0 .3rem; }",
        "@media (max-width: 30rem) { header { flex-wrap: wrap; } header nav { margin-left: 0; }",
        "  li .drop { opacity: 1; } }",
        "</style>",
        "</head>",
        "<body>",
        "<main>",
        "<header>",
        "  <div>",
        "    <h1>todos</h1>",
        "    <p>a REST API written in Mah, kept in memory</p>",
        "  </div>",
        "  <nav>",
        "    <a class='chip' href='/docs' title='Swagger UI for the API'>API docs</a>",
        "    <a class='chip' href='/openapi.json'>openapi.json</a>",
        "  </nav>",
        "</header>",
        "<div class='card'>",
        "  <form id='new'>",
        "    <input id='title' type='text' placeholder='What needs doing?' autocomplete='off' aria-label='new todo'>",
        "    <button class='primary' type='submit'>Add</button>",
        "  </form>",
        "  <div class='progress'><div id='progress'></div></div>",
        "  <div class='bar'>",
        "    <span class='count' id='count'></span>",
        "    <span class='filters'>",
        "      <button data-show='all' aria-pressed='true'>All</button>",
        "      <button data-show='open' aria-pressed='false'>Open</button>",
        "      <button data-show='done' aria-pressed='false'>Done</button>",
        "    </span>",
        "  </div>",
        "  <ul id='list'></ul>",
        "  <div class='foot'>",
        "    <span>double-click a todo to rename it</span>",
        "    <button id='clear'>Clear done</button>",
        "  </div>",
        "</div>",
        "<div id='status' role='status'></div>",
        "<footer>",
        "  <p>press <kbd>/</kbd> to add a todo &middot; restarting the server forgets everything &middot;",
        "    <a href='/api'>/api</a></p>",
        "  <p class='made'>made with <a href='" + mahlang + "' target='_blank' rel='noreferrer'>Mah</a>",
        "    &#x263E; &middot; <a href='" + repo + "' target='_blank' rel='noreferrer'>source</a></p>",
        "</footer>",
        "</main>",
        "<script>",
        "const $ = (id) => document.getElementById(id)",
        "const list = $('list'), count = $('count'), status = $('status'), title = $('title')",
        "let show = 'all'",
        "let todos = []",
        "",
        "// Every call is a plain fetch against the JSON API, errors included.",
        "async function call(method, path, body) {",
        "  const res = await fetch(path, {",
        "    method: method,",
        "    headers: body === undefined ? {} : { 'content-type': 'application/json' },",
        "    body: body === undefined ? undefined : JSON.stringify(body)",
        "  })",
        "  const text = await res.text()",
        "  let data = null",
        "  try { data = text === '' ? null : JSON.parse(text) } catch (e) { data = null }",
        "  if (!res.ok) { throw new Error(data && data.message ? data.message : res.status + ' ' + res.statusText) }",
        "  return data",
        "}",
        "",
        "function say(text) { status.textContent = text }",
        "",
        "// '5m ago' for an ISO time, the way a list wants it.",
        "function ago(iso) {",
        "  const s = Math.max(0, (Date.now() - new Date(iso).getTime()) / 1000)",
        "  if (s < 60) return 'just now'",
        "  if (s < 3600) return Math.floor(s / 60) + 'm ago'",
        "  if (s < 86400) return Math.floor(s / 3600) + 'h ago'",
        "  return Math.floor(s / 86400) + 'd ago'",
        "}",
        "",
        "// Swaps the title for a text box; Enter or leaving it saves, Escape doesn't.",
        "function rename(todo, label) {",
        "  const box = document.createElement('input')",
        "  box.type = 'text'",
        "  box.className = 'edit'",
        "  box.value = todo.title",
        "  let finished = false",
        "  const finish = (save) => {",
        "    if (finished) return",
        "    finished = true",
        "    const next = box.value.trim()",
        "    if (save && next !== '' && next !== todo.title) {",
        "      work(() => call('PATCH', '/todos/' + todo.id, { title: next }))",
        "    } else { draw() }",
        "  }",
        "  box.onkeydown = (e) => { if (e.key === 'Enter') finish(true); if (e.key === 'Escape') finish(false) }",
        "  box.onblur = () => finish(true)",
        "  label.replaceWith(box)",
        "  box.focus()",
        "  box.select()",
        "}",
        "",
        "function row(todo) {",
        "  const item = document.createElement('li')",
        "  if (todo.done) item.className = 'done'",
        "  const box = document.createElement('input')",
        "  box.type = 'checkbox'",
        "  box.className = 'check'",
        "  box.checked = todo.done",
        "  box.setAttribute('aria-label', 'done')",
        "  box.onchange = () => work(() => call('PATCH', '/todos/' + todo.id, { done: box.checked }))",
        "  const label = document.createElement('span')",
        "  label.className = 'title'",
        "  label.textContent = todo.title",
        "  label.ondblclick = () => rename(todo, label)",
        "  const when = document.createElement('span')",
        "  when.className = 'when'",
        "  when.textContent = ago(todo.created_at)",
        "  when.title = todo.created_at",
        "  const drop = document.createElement('button')",
        "  drop.className = 'drop'",
        "  drop.textContent = '×'",
        "  drop.title = 'delete'",
        "  drop.setAttribute('aria-label', 'delete ' + todo.title)",
        "  drop.onclick = () => work(() => call('DELETE', '/todos/' + todo.id))",
        "  item.append(box, label, when, drop)",
        "  return item",
        "}",
        "",
        "function draw() {",
        "  const done = todos.filter((t) => t.done).length",
        "  const open = todos.length - done",
        "  const shown = todos.filter((t) => show === 'all' || (show === 'done') === t.done)",
        "  list.textContent = ''",
        "  for (const todo of shown) { list.appendChild(row(todo)) }",
        "  if (shown.length === 0) {",
        "    const empty = document.createElement('li')",
        "    empty.className = 'empty'",
        "    empty.textContent = todos.length === 0 ? 'Nothing to do yet. Add something above.'",
        "      : show === 'done' ? 'Nothing finished yet.' : 'All done. Nice.'",
        "    list.appendChild(empty)",
        "  }",
        "  count.textContent = open + ' open · ' + done + ' done'",
        "  $('progress').style.width = todos.length === 0 ? '0' : (100 * done / todos.length) + '%'",
        "  $('clear').disabled = done === 0",
        "  for (const button of document.querySelectorAll('[data-show]')) {",
        "    button.setAttribute('aria-pressed', button.dataset.show === show)",
        "  }",
        "}",
        "",
        "async function load() {",
        "  try {",
        "    const data = await call('GET', '/todos')",
        "    todos = data.todos",
        "    draw()",
        "    say('')",
        "  } catch (e) {",
        "    say(e.message)",
        "  }",
        "}",
        "",
        "// Do the thing, then show the truth: reload first, then say what went",
        "// wrong if anything did.",
        "async function work(action) {",
        "  let bad = null",
        "  try { await action() } catch (e) { bad = e }",
        "  await load()",
        "  if (bad !== null) { say(bad.message) }",
        "}",
        "",
        "$('new').onsubmit = (event) => {",
        "  event.preventDefault()",
        "  const what = title.value.trim()",
        "  if (what === '') { return }",
        "  title.value = ''",
        "  work(() => call('POST', '/todos', { title: what }))",
        "}",
        "$('clear').onclick = () => work(() => call('DELETE', '/todos/done'))",
        "for (const button of document.querySelectorAll('[data-show]')) {",
        "  button.onclick = () => { show = button.dataset.show; draw() }",
        "}",
        "document.addEventListener('keydown', (e) => {",
        "  if (e.key === '/' && document.activeElement.tagName !== 'INPUT') { e.preventDefault(); title.focus() }",
        "})",
        "setInterval(() => { if (document.activeElement.tagName !== 'INPUT') draw() }, 60000)",
        "",
        "title.focus()",
        "load()",
        "</script>",
        "</body>",
        "</html>"
    ].join("\n")
}

## Swagger UI over the OpenAPI document at /openapi.json.
export fn docs_page() -> String {
    [
        "<!doctype html>",
        "<html lang='en'>",
        "<head>",
        "<meta charset='utf-8'>",
        "<meta name='viewport' content='width=device-width, initial-scale=1'>",
        "<title>p05 todo api docs</title>",
        "<link rel='stylesheet' href='" + swagger_ui + "/swagger-ui.css'>",
        "<style>",
        "body { margin: 0; background: #fafafa; }",
        ".back { display: block; padding: .6rem 1.25rem; background: #1d2130; color: #fff;",
        "  font: 600 14px/1.4 system-ui, sans-serif; text-decoration: none; }",
        ".back:hover { background: #2b3045; }",
        ".swagger-ui .topbar { display: none; }",
        "</style>",
        "</head>",
        "<body>",
        "<a class='back' href='/'>&larr; back to the todo list</a>",
        "<div id='swagger'><p style='font-family: system-ui; padding: 1rem'>Loading Swagger UI&hellip;",
        "  if it doesn't load, the raw document is at <a href='/openapi.json'>/openapi.json</a>.</p></div>",
        "<script src='" + swagger_ui + "/swagger-ui-bundle.js' crossorigin></script>",
        "<script>",
        "window.ui = SwaggerUIBundle({",
        "  url: '/openapi.json',",
        "  dom_id: '#swagger',",
        "  deepLinking: true,",
        "  tryItOutEnabled: true,",
        "  displayRequestDuration: true",
        "})",
        "</script>",
        "</body>",
        "</html>"
    ].join("\n")
}
